# Copy to .env and fill in only what you want to run "for real".
# Any stage without credentials falls back to deterministic mock output, so the
# whole LangGraph pipeline always runs end to end.

# ── ① ideate — LLM (provider-swappable) ─────────────────────────────
# Swap providers by changing these two lines. No code changes needed.
#   anthropic:     LLM_PROVIDER=anthropic     LLM_MODEL=claude-sonnet-5
#   openai:        LLM_PROVIDER=openai        LLM_MODEL=gpt-4.1
#   google-genai:  LLM_PROVIDER=google-genai  LLM_MODEL=gemini-2.5-pro
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5

# Set the key for whichever provider you selected above:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── ② narrate — text-to-speech ──────────────────────────────────────
TTS_PROVIDER=auto            # elevenlabs | mock | auto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── ③ visualize — image / b-roll generation ─────────────────────────
IMAGE_PROVIDER=auto          # flux | mock | auto
IMAGE_API_KEY=

# ── ⑤ publish — YouTube upload ──────────────────────────────────────
PUBLISH_PROVIDER=auto        # youtube | mock | auto
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
